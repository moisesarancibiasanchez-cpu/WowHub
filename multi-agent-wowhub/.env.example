# =============================================================================
# WowHub Multi-Agent System v1.1.0 — Configuration Template
# Copiar a .env y completar con valores reales
# =============================================================================

# ---- MiniMax API ----
# Obtener API key en: https://platform.minimaxi.com
MM_API_KEY=sk-your-api-key-here
# MM_USE_MOCK=true  -> usa respuestas mock (desarrollo, sin costo)
# MM_USE_MOCK=false -> usa API real de MiniMax
MM_USE_MOCK=true
MM_BASE_URL=https://api.minimaxi.com/v1
MM_MODEL_PREMIUM=MiniMax-Text-01
MM_MODEL_CODE=MiniMax-Text-01
MM_MODEL_FAST=MiniMax-Text-01
LOG_LEVEL=INFO
MAX_ITERATIONS=5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---- GitHub ----
# Generar token en: https://github.com/settings/tokens
# Permisos: repo, workflow
GITHUB_TOKEN=
GITHUB_OWNER=moisesarancibiasanchez-cpu
GITHUB_REPO=WowHub
GITHUB_BRANCH=main

# ---- Railway ----
RAILWAY_URL=https://wowhub-api-production.up.railway.app
RAILWAY_DASHBOARD=https://railway.app/dashboard
APP_NAME=WowHub
APP_ENV=production

# ---- WowHub App (Railway inyecta DATABASE_URL automaticamente) ----
DEBUG=false
BASE_URL=https://wowhub-api-production.up.railway.app
PUBLIC_BASE_URL=https://wowhub.app
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14
CORS_ORIGINS=https://wowhub.app,https://wowhub-api-production.up.railway.app

# ---- Paths (relativos al proyecto, NO hardcodear /workspace) ----
# Ubicacion del repo WowHub_GIT (hermano de multi-agent-wowhub)
WOWHUB_APP=../WowHub_GIT
MULTI_AGENT_HOME=.
# Documento de casos de prueba V134.2
CP_DOC=../WowHub_GIT/docs/TEST_CASES_V134_2.md
# Directorio para cache y resultados (crear si no existe)
CACHE_DIR=./cache
RESULTS_DIR=.
