# WowHub — Variables de entorno (ejemplo completo v0.2.0)
# Copiar a .env y ajustar valores

# ── App ─────────────────────────────────────────────
APP_NAME=WowHub
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-string-min-32-chars-please-ok
BASE_URL=http://localhost:8000
# v1.9.1-r2: el dominio PÚBLICO de la plataforma es wowhub.app (NO el backend de Railway).
# Las tools `get_tenant_dashboard_urls` y `get_tenant_public_urls` lo usan como
# prefijo para armar los links absolutos que se muestran al usuario.
PUBLIC_BASE_URL=https://wowhub.app

# ── Base de datos ───────────────────────────────────
# Dev: SQLite. Prod: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./wowhub.db
# DATABASE_URL=postgresql+psycopg://wowhub:wowhub@localhost:5432/wowhub

# ── Auth ────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-min-32-chars-random-ok
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14

# ── CORS ────────────────────────────────────────────
# Lista separada por comas. Vacío = sin CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://wowhub-api-production.up.railway.app

# ── Storage ─────────────────────────────────────────
STORAGE_BACKEND=local          # local (futuro: s3)
STORAGE_PATH=./storage
# Uploads: autoridad en app/services/upload_service.py
UPLOAD_MAX_BYTES=3145728       # 3 MB
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png

# ── Email ───────────────────────────────────────────
# backends: log | console | smtp | resend
EMAIL_BACKEND=log
EMAIL_FROM=no-reply@wowhub.app
EMAIL_FROM_NAME=WowHub

# SMTP (si EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Resend (si EMAIL_BACKEND=resend)
RESEND_API_KEY=

# ── MercadoPago ─────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ENABLED=false
PAYMENT_DEFAULT_PROVIDER=mock     # mock | mercadopago

# ── WhatsApp Business (HU_16, stub) ──────────────────────────────
# App secret del webhook. Si está vacío el endpoint POST /api/v1/webhooks/whatsapp
# devuelve 503 (fail-closed). Configurar antes de aceptar tráfico real.
WHATSAPP_BUSINESS_TOKEN=

# ── Webhooks ────────────────────────────────────────
WEBHOOK_SECRET=change-me-webhook-secret-min-32-chars-ok
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_SECONDS=10

# ── Rate limit ──────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_ORDERS_PER_MIN=60
RATE_LIMIT_DEFAULT_PER_MIN=200

# ── Audit ───────────────────────────────────────────
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365

# ── Password policy ────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_LETTER=true
PASSWORD_REQUIRE_DIGIT=true

# ── Loyalty defaults ────────────────────────────────
LOYALTY_POINTS_PER_CURRENCY_UNIT=1
LOYALTY_CURRENCY_UNIT=100
LOYALTY_REDEEM_RATE=100
LOYALTY_MIN_REDEEM=100

# ── Search ──────────────────────────────────────────
SEARCH_MAX_RESULTS=50

# ── AI Core (WowHub) ─────────────────────────────────
# Proveedor LLM. openai_compatible = /v1 (recomendado para MiniMax)
#                                anthropic        = /anthropic (SDK Anthropic)
LLM_PROVIDER=openai_compatible
LLM_API_KEY=                  # Subscription Key de MiniMax (Token Plan)
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Circuit breaker: número de fallos consecutivos antes de abrir el circuito
LLM_CB_FAIL_THRESHOLD=5
# Circuit breaker: segundos que el circuito permanece abierto antes de probar half-open
LLM_CB_RESET_SECONDS=60

# Chat por usuario
AI_CONTEXT_MESSAGES=20
AI_DAILY_MESSAGE_LIMIT=100

# Fallback cuando el LLM está caído: respuestas pre-canned por sub-agente
AI_FALLBACK_ENABLED=true

# ── UI v2 (migración dark → light, fase 1) ─────────────
# Feature flag para activar el nuevo skin (tokens-v2.css).
# Default false: app 100% dark, idéntico a v1.9.1-r8.
# Setear true en .env (o en Railway) para activar el skin light + dark sidebar.
# Rollback instantáneo: poner false + restart.
# Override por request (sin restart): append ?ui=v2 a cualquier URL.
# Diagnóstico en /diag/ui-v2
UI_V2_ENABLED=false
# Cache-bust para tokens-v2.css. Cambiar este string cuando se actualice el CSS
# para forzar recarga del navegador sin purgar caché manualmente.
UI_V2_BUILD_ID=v2-tokens-2026-08-22

# ---------------------------------------------------------------------------
# FIX 2026-09-27 - seguridad y despliegue (auditoria)
# ---------------------------------------------------------------------------
# En PRODUCCION la app ABORTA si alguno de estos queda con el valor default.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBHOOK_SECRET=change-me-webhook-secret-min-32-chars-ok
DEBUG=true

# /storage montado como StaticFiles SIN autenticacion: expone los archivos de
# TODOS los tenants. Debe ser false en produccion; los archivos se sirven por
# el endpoint autenticado GET /tenants/{tid}/uploads/{id}/content
STORAGE_PUBLIC=true

# Sembrar datos demo (crea maria@cafenorte.cl / demo1234 con rol OWNER).
# NUNCA true en produccion.
SEED_DEMO_DATA=false

# ---------------------------------------------------------------------------
# HU_39 — Encriptacion de campos sensibles (Fernet)
# ---------------------------------------------------------------------------
# Clave Fernet (32 bytes codificados en base64 url-safe = 44 chars).
# Aplicada a columnas con datos personales via app.core.encryption.
#
# En DESARROLLO se permite dejarla vacia: se deriva deterministicamente de
# SECRET_KEY (HKDF-SHA256). En PRODUCCION es OBLIGATORIA — la app aborta
# el arranque si esta vacia o es placeholder.
#
# Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# IMPORTANTE: si la perdes, TODOS los PII encriptados con esta clave son
# irrecuperables. Guardala en un gestor de secretos (Railway / Vault / 1Password).
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Observabilidad (P1)
# ---------------------------------------------------------------------------
# OTLP: sin exporter ni span processor las trazas se generan y se descartan.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=wowhub-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.01

# ---------------------------------------------------------------------------
# Background jobs (Celery + Redis)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---------------------------------------------------------------------------
# S3 / R2 (opcional; storage_backend=local mientras no se configure)
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=