# WowHub — Variables de entorno (ejemplo)
# Copiar a .env y ajustar valores

# ── App ─────────────────────────────────────────────
APP_NAME=WowHub
APP_ENV=development        # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-string-min-32-chars-please-ok
BASE_URL=http://localhost:8000

# ── Base de datos ───────────────────────────────────
# Para el demo usamos SQLite. Cambiar a postgresql+psycopg en producción.
DATABASE_URL=sqlite:///./wowhub.db
# DATABASE_URL=postgresql+psycopg://wowhub:wowhub@localhost:5432/wowhub

# ── Auth ────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-min-32-chars-random-ok
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14

# ── CORS ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Storage ─────────────────────────────────────────
# (placeholder; en MVP no se usa todavía)
STORAGE_BACKEND=local
STORAGE_PATH=./storage
